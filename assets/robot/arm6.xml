<!--
  6-DOF anthropomorphic arm with a spherical wrist and a parallel-jaw gripper.

  Zero configuration: upper arm vertical, forearm horizontal along +x,
  tool axis along +x. Joint 4 and joint 6 roll about the forearm / tool axis,
  joint 5 pitches the wrist. The three wrist axes intersect at the wrist
  centre, which is what makes the closed-form IK in robotics/kinematics.py
  possible.

  Lengths (m): shoulder height 0.20 above the mounting plate, upper arm 0.40,
  elbow to wrist centre 0.38, wrist centre to TCP 0.17.

  Collision bits: 1 = static scene, 2 = robot, 4 = movable objects.
  Robot geoms do not collide with each other (contype 2 / conaffinity 5).
-->
<mujoco model="arm6">
  <worldbody>
    <body name="base" pos="0 0 0.42" childclass="arm">
      <geom name="base_geom" type="cylinder" size="0.075 0.04" pos="0 0 0.04" rgba="0.25 0.25 0.28 1"/>

      <body name="link1" pos="0 0 0.08" gravcomp="1">
        <joint name="joint1" axis="0 0 1" range="-170 170"/>
        <inertial pos="0 0 0.06" mass="2.5" diaginertia="0.010 0.010 0.008"/>
        <geom name="link1_geom" type="cylinder" size="0.065 0.06" pos="0 0 0.06"/>

        <body name="link2" pos="0 0 0.12" gravcomp="1">
          <joint name="joint2" axis="0 1 0" range="-60 115"/>
          <inertial pos="0 0 0.20" mass="3.0" diaginertia="0.045 0.045 0.004"/>
          <geom name="shoulder_geom" type="cylinder" fromto="0 -0.07 0 0 0.07 0" size="0.06" rgba="0.25 0.25 0.28 1"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0.02 0 0 0.38" size="0.045"/>

          <body name="link3" pos="0 0 0.40" gravcomp="1">
            <joint name="joint3" axis="0 1 0" range="-120 150"/>
            <inertial pos="0.15 0 0" mass="1.8" diaginertia="0.002 0.015 0.015"/>
            <geom name="elbow_geom" type="cylinder" fromto="0 -0.055 0 0 0.055 0" size="0.05" rgba="0.25 0.25 0.28 1"/>
            <geom name="link3_geom" type="capsule" fromto="0.03 0 0 0.28 0 0" size="0.038"/>

            <body name="link4" pos="0.30 0 0" gravcomp="1">
              <joint name="joint4" axis="1 0 0" range="-180 180"/>
              <inertial pos="0.04 0 0" mass="0.6" diaginertia="0.0005 0.0006 0.0006"/>
              <geom name="link4_geom" type="cylinder" fromto="0 0 0 0.05 0 0" size="0.035"/>

              <body name="link5" pos="0.08 0 0" gravcomp="1">
                <joint name="joint5" axis="0 1 0" range="-125 125"/>
                <inertial pos="0 0 0" mass="0.5" diaginertia="0.0004 0.0004 0.0004"/>
                <geom name="link5_geom" type="cylinder" fromto="0 -0.04 0 0 0.04 0" size="0.036" rgba="0.25 0.25 0.28 1"/>

                <body name="link6" pos="0 0 0" gravcomp="1">
                  <joint name="joint6" axis="1 0 0" range="-180 180"/>
                  <inertial pos="0.06 0 0" mass="0.3" diaginertia="0.0002 0.0003 0.0003"/>
                  <geom name="flange_geom" type="cylinder" fromto="0.04 0 0 0.09 0 0" size="0.032"/>

                  <body name="gripper" pos="0.09 0 0" gravcomp="1">
                    <inertial pos="0.02 0 0" mass="0.4" diaginertia="0.0006 0.0003 0.0006"/>
                    <geom name="palm_geom" type="box" size="0.02 0.06 0.022" pos="0.02 0 0" rgba="0.2 0.2 0.22 1"/>
                    <site name="tcp" pos="0.08 0 0" size="0.006" rgba="1 0.3 0.1 0.6" group="3"/>

                    <body name="finger_left" pos="0.035 0 0" gravcomp="1">
                      <joint name="finger_left" class="finger" axis="0 1 0"/>
                      <inertial pos="0.03 0.012 0" mass="0.03" diaginertia="1e-5 1e-5 1e-5"/>
                      <geom name="finger_left_pad" class="pad" pos="0.03 0.012 0"/>
                    </body>
                    <body name="finger_right" pos="0.035 0 0" gravcomp="1">
                      <joint name="finger_right" class="finger" axis="0 -1 0"/>
                      <inertial pos="0.03 -0.012 0" mass="0.03" diaginertia="1e-5 1e-5 1e-5"/>
                      <geom name="finger_right_pad" class="pad" pos="0.03 -0.012 0"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <tendon>
    <fixed name="grip">
      <joint joint="finger_left" coef="0.5"/>
      <joint joint="finger_right" coef="0.5"/>
    </fixed>
  </tendon>

  <equality>
    <joint joint1="finger_left" joint2="finger_right" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <actuator>
    <general name="act1" class="arm" joint="joint1" ctrlrange="-2.967 2.967" forcerange="-150 150" gainprm="900" biasprm="0 -900 -70"/>
    <general name="act2" class="arm" joint="joint2" ctrlrange="-1.047 2.007" forcerange="-200 200" gainprm="1400" biasprm="0 -1400 -90"/>
    <general name="act3" class="arm" joint="joint3" ctrlrange="-2.094 2.618" forcerange="-150 150" gainprm="900" biasprm="0 -900 -55"/>
    <general name="act4" class="arm" joint="joint4" ctrlrange="-3.1416 3.1416" forcerange="-40 40" gainprm="150" biasprm="0 -150 -8"/>
    <general name="act5" class="arm" joint="joint5" ctrlrange="-2.182 2.182" forcerange="-40 40" gainprm="150" biasprm="0 -150 -8"/>
    <general name="act6" class="arm" joint="joint6" ctrlrange="-3.1416 3.1416" forcerange="-30 30" gainprm="80" biasprm="0 -80 -4"/>
    <!-- gripper: position servo on the mean finger travel, force limited -->
    <general name="act_grip" class="arm" tendon="grip" ctrlrange="0 0.045" forcerange="-30 30" gainprm="1500" biasprm="0 -1500 -40"/>
  </actuator>
</mujoco>
